<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { title: 'Iniciar sesión' }) %>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-brand">
        <div class="logo-circle">F1</div>
        <h1>Final01</h1>
        <p>Ingresa con tu cuenta para continuar</p>
      </div>

      <div id="login-alert" class="alert alert-error hidden"></div>

      <form id="login-form" novalidate>
        <div class="form-group">
          <label for="username">Usuario</label>
          <input type="text" id="username" name="username" class="form-control" autocomplete="username" required>
        </div>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
        </div>
        <button type="submit" id="login-submit" class="btn btn-primary btn-block">Ingresar</button>
      </form>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
